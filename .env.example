DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
API_ANON_RATE=120/hour

POSTGRES_DB=auto_ria
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_TASK_TIME_LIMIT=120

# The project works without an LLM by using deterministic ranking.
# Supported values: none, ollama, openai, openrouter
AI_PROVIDER=none
AI_MODEL=mistral
AI_REQUEST_TIMEOUT=45
OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_API_KEY=
OPENROUTER_API_KEY=

RECOMMENDATION_MIN_BUDGET_RATIO=0.7
PARSER_RESULT_LIMIT=20
PARSER_REFRESH_SECONDS=300
PLAYWRIGHT_HEADLESS=true

# Required only when starting Docker Compose with --profile bot.
BOT_TOKEN=
API_BASE_URL=http://web:8000/api
BOT_API_TIMEOUT=60
BOT_POLL_ATTEMPTS=6
BOT_POLL_INTERVAL=3
